{
  "defaultType": "code",
  "thinking": "medium",
  "maxAttempts": 3,
  "worktree": {
    "enabled": true,
    "setup": [
      "npm install --prefer-offline --no-audit --no-fund --ignore-scripts"
    ]
  },
  "routing": {
    "git": {
      "tier": "quick",
      "thinking": "low"
    },
    "docs": {
      "tier": "quick",
      "thinking": "low"
    },
    "test": {
      "tier": "standard"
    },
    "code": {
      "tier": "standard"
    },
    "refactor": {
      "tier": "premium"
    }
  },
  "tiers": {
    "quick": {
      "chain": [
        "opencode-go/space-bunny-free",
        "openrouter/poolside/laguna-s-2.1:free",
        "openrouter/thinkingmachines/inkling:free",
        "opencode-go/longcat-2.5-preview-free"
      ],
      "thinking": "low"
    },
    "standard": {
      "chain": [
        "opencode-go/kimi-k2.7-code",
        "opencode-go/kimi-k3",
        "opencode-go/qwen3.8-max",
        "opencode-go/deepseek-v4-pro",
        "xai/grok-4.6",
        "opencode-go/glm-5.3",
        "opencode-go/minimax-m3",
        "opencode-go/mimo-v2.6-pro"
      ]
    },
    "premium": {
      "chain": [
        "xai/grok-4.7",
        "openrouter/anthropic/claude-opus-5"
      ],
      "thinking": "high"
    }
  },
  "budgets": {
    "default": {
      "maxTurns": 150,
      "maxWallMin": 60,
      "maxContextPct": 80
    },
    "ticket": {
      "maxTurns": 400,
      "maxWallMin": 180
    }
  },
  "softLimitPct": 85,
  "maxHandoffs": 3,
  "onExceed": {
    "maxTurns": {
      "to": "next",
      "mode": "new-process"
    },
    "maxWallMin": {
      "to": "next",
      "mode": "new-process"
    },
    "maxContextPct": {
      "to": "same-tier",
      "mode": "new-process"
    }
  },
  "crossTier": "up",
  "jev": {
    "model": [
      "openrouter/typesafe/jev-1.13",
      "openrouter/~typesafe/jev-latest",
      "typesafe/jev-latest"
    ]
  }
}
